{
  "manifest_version": 3,
  "name": "广告清理工具-Ad-Cleaner",
  "version": "0.9.27",
  "description": "广告清理工具-Ad-Cleaner：拦截广告、隐藏元素、管理站点规则。 / Ad Cleaner Tool-Ad-Cleaner: block ads, hide elements, manage site rules.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https: http:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  },
  "action": {
    "default_title": "广告清理工具-Ad-Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "theme.js",
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core-blocklist",
        "enabled": true,
        "path": "rules/ad-block-rules.json"
      },
      {
        "id": "privacy-coverage",
        "enabled": true,
        "path": "rules/privacy-coverage-rules.json"
      },
      {
        "id": "always-active",
        "enabled": true,
        "path": "rules/always-active-rules.json"
      }
    ]
  }
}
